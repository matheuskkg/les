      "Sessao" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "papel" : {
            "type" : "string",
            "enum" : [ "CLIENTE", "ADMIN" ]
          },
          "usuarioId" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "email", "papel", "usuarioId" ]
      }
