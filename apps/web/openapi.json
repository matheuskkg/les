      },
      "EntradaDeLogin" : {
        "type" : "object",
        "properties" : {
          "login" : {
            "type" : "string",
            "minLength" : 1
          },
          "senha" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "login", "senha" ]
      },
      "LivroDetalheDto" : {
