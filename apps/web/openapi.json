        "required" : [ "altura", "ano", "autores", "categorias", "codigoBarras", "disponivel", "edicao", "editora", "id", "isbn", "largura", "paginas", "peso", "profundidade", "sinopse", "titulo" ]
      },
      "LivroListadoDto" : {
        "type" : "object",
        "properties" : {
          "ano" : {
            "type" : "integer",
            "format" : "int32"
          },
          "autores" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "categorias" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CategoriaDto"
            }
          },
          "disponivel" : {
            "type" : "integer",
            "format" : "int32"
          },
          "editora" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "precoVenda" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "1234.56"
          },
          "titulo" : {
            "type" : "string"
          }
        },
        "required" : [ "ano", "autores", "categorias", "disponivel", "editora", "id", "titulo" ]
      },
      "PaginaCategoriaDto" : {
        "type" : "object",
        "properties" : {
          "itens" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CategoriaDto"
            }
          },
          "pagina" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tamanho" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalItens" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPaginas" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "itens", "pagina", "tamanho", "totalItens", "totalPaginas" ]
      },
      "PaginaLivroListadoDto" : {
        "type" : "object",
        "properties" : {
          "itens" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LivroListadoDto"
            }
          },
          "pagina" : {
            "type" : "integer",
            "format" : "int32"
          },
          "tamanho" : {
            "type" : "integer",
