{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "API da Livraria",
    "version" : "1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/livros" : {
      "get" : {
        "operationId" : "listar",
        "parameters" : [ {
          "in" : "query",
          "name" : "titulo",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "autor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "categoria",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          }
        }, {
          "in" : "query",
          "name" : "editora",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "isbn",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "codigoBarras",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "anoDe",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "query",
          "name" : "anoAte",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "query",
          "name" : "edicao",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "paginasDe",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "query",
          "name" : "paginasAte",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "in" : "query",
          "name" : "codigo",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "description" : "Página, a partir de 0.",
          "in" : "query",
          "name" : "pagina",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "description" : "Itens por página (padrão 20, máximo 100).",
          "in" : "query",
          "name" : "tamanho",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "Ordenação no formato campo,asc|desc; pode ser repetido. Campos permitidos: titulo, ano, editora. Padrão: titulo,asc.",
          "explode" : true,
          "in" : "query",
          "name" : "ordem",
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaginaLivroListadoDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "livro-controller" ]
      }
    },
    "/api/livros/categorias" : {
      "get" : {
        "operationId" : "listarCategorias",
        "parameters" : [ {
          "description" : "Página, a partir de 0.",
          "in" : "query",
          "name" : "pagina",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "description" : "Itens por página (padrão 20, máximo 100).",
          "in" : "query",
          "name" : "tamanho",
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "Ordenação no formato campo,asc|desc; pode ser repetido. Campos permitidos: nome. Padrão: nome,asc.",
          "explode" : true,
          "in" : "query",
          "name" : "ordem",
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "style" : "form"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PaginaCategoriaDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "categoria-controller" ]
      }
    },
    "/api/livros/{id}" : {
      "get" : {
        "operationId" : "buscar",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LivroDetalheDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "livro-controller" ]
      }
    },
    "/api/sessao" : {
      "delete" : {
        "operationId" : "sair",
        "responses" : {
          "204" : {
            "description" : "Sessão encerrada"
          }
        },
        "summary" : "Encerra a sessão e apaga o cookie",
        "tags" : [ "sessao-controller" ]
      },
      "get" : {
        "operationId" : "obter",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Sessao"
                }
              }
            },
            "description" : "Usuário logado"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Sem sessão válida"
          }
        },
        "summary" : "Consulta o usuário logado e emite o cookie CSRF",
        "tags" : [ "sessao-controller" ]
      },
      "post" : {
        "operationId" : "entrar",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EntradaDeLogin"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Sessao"
                }
              }
            },
            "description" : "Sessão aberta"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Login ou senha em branco"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Login ou senha inválidos"
          }
        },
        "summary" : "Entra no sistema e grava o cookie de sessão",
        "tags" : [ "sessao-controller" ]
      }
    }
  },
  "components" : {
