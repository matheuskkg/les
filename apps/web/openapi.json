            "format" : "int32"
          },
          "autores" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "categorias" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CategoriaDto"
            }
          },
          "codigoBarras" : {
            "type" : "string"
          },
          "disponivel" : {
            "type" : "integer",
            "format" : "int32"
          },
          "edicao" : {
            "type" : "string"
          },
          "editora" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "isbn" : {
            "type" : "string"
          },
          "largura" : {
            "type" : "number"
          },
          "paginas" : {
            "type" : "integer",
            "format" : "int32"
          },
          "peso" : {
            "type" : "number"
          },
          "precoVenda" : {
            "type" : "string",
            "format" : "decimal",
            "example" : "1234.56"
          },
          "profundidade" : {
            "type" : "number"
          },
          "sinopse" : {
            "type" : "string"
          },
          "titulo" : {
            "type" : "string"
          }
