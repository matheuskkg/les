  <diagram id="modulo-hexagonal" name="modulo-hexagonal"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m-outro" value="«outro módulo»&lt;br&gt;&lt;b&gt;Outro módulo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;só casos de uso e portas públicas&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="460" height="60" as="geometry" /></mxCell><mxCell id="ctr-web" value="&lt;b&gt;infraestrutura.web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;adapter de entrada (de cada módulo)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="330" as="geometry" /></mxCell><mxCell id="ctr-app" value="&lt;b&gt;aplicacao&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;casos de uso e portas de saída&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="460" height="400" as="geometry" /></mxCell><mxCell id="ctr-dom" value="&lt;b&gt;dominio&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="440" height="400" as="geometry" /></mxCell><mxCell id="ctr-pers" value="&lt;b&gt;infraestrutura.persistencia&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="600" width="220" height="260" as="geometry" /></mxCell><mxCell id="ctr-ext" value="&lt;b&gt;infraestrutura (adapters externos)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="600" width="220" height="130" as="geometry" /></mxCell><mxCell id="ctrl" value="«adaptador de entrada»&lt;br&gt;&lt;b&gt;ControllerRest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;@RestController, recebe a requisição HTTP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-web"><mxGeometry x="20" y="50" width="260" height="110" as="geometry" /></mxCell><mxCell id="dto" value="&lt;b&gt;DTO e mapper&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DTO de entrada e de saída,&lt;br&gt;mapper para o comando e a resposta&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-web"><mxGeometry x="20" y="190" width="260" height="100" as="geometry" /></mxCell><mxCell id="caso" value="«porta de entrada»&lt;br&gt;&lt;b&gt;CasoDeUso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;executar(comando)&lt;br&gt;recebe regras e portas pelo construtor&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-app"><mxGeometry x="30" y="50" width="400" height="100" as="geometry" /></mxCell><mxCell id="regraApp" value="«regra de aplicação»&lt;br&gt;&lt;b&gt;RegraDeAplicacao&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;implementa Regra e consulta dados pelas portas&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-app"><mxGeometry x="30" y="190" width="400" height="80" as="geometry" /></mxCell><mxCell id="portaRep" value="«interface»&lt;br&gt;&lt;b&gt;PortaRepositorio&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-app"><mxGeometry x="30" y="290" width="190" height="80" as="geometry" /></mxCell><mxCell id="portaExt" value="«interface»&lt;br&gt;&lt;b&gt;PortaServicoExterno&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-app"><mxGeometry x="240" y="290" width="190" height="80" as="geometry" /></mxCell><mxCell id="modelo" value="&lt;b&gt;Modelo de domínio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;entidades e agregados que protegem&lt;br&gt;os próprios invariantes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-dom"><mxGeometry x="30" y="40" width="380" height="70" as="geometry" /></mxCell><mxCell id="vo" value="«value object»&lt;br&gt;&lt;b&gt;ValueObject&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-dom"><mxGeometry x="30" y="130" width="180" height="60" as="geometry" /></mxCell><mxCell id="calc" value="«cálculo»&lt;br&gt;&lt;b&gt;CalculoDeNegocio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;um método público&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-dom"><mxGeometry x="230" y="130" width="180" height="60" as="geometry" /></mxCell><mxCell id="regra" value="«interface»&lt;br&gt;&lt;b&gt;Regra&amp;lt;T&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;validar(alvo, violacoes): acumula, não lança&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-dom"><mxGeometry x="30" y="220" width="380" height="60" as="geometry" /></mxCell><mxCell id="regraPura" value="«regra pura»&lt;br&gt;&lt;b&gt;RegraPura&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;não consulta dados&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-dom"><mxGeometry x="30" y="320" width="380" height="50" as="geometry" /></mxCell><mxCell id="adPers" value="«adaptador de saída»&lt;br&gt;&lt;b&gt;AdapterRepositorio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;usa SpringDataRepositorio&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-pers"><mxGeometry x="20" y="40" width="180" height="60" as="geometry" /></mxCell><mxCell id="map" value="«mapper»&lt;br&gt;&lt;b&gt;MapperDeEntidade&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;domínio e entidade JPA&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-pers"><mxGeometry x="20" y="130" width="180" height="50" as="geometry" /></mxCell><mxCell id="ent" value="«entidade JPA»&lt;br&gt;&lt;b&gt;EntidadeJpa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;*Jpa, com @Audited&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-pers"><mxGeometry x="20" y="200" width="180" height="50" as="geometry" /></mxCell><mxCell id="adExt" value="«adaptador de saída»&lt;br&gt;&lt;b&gt;AdapterServicoExterno&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;operadora e frete simulados,&lt;br&gt;provedores de IA&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=12;" vertex="1" parent="ctr-ext"><mxGeometry x="20" y="40" width="180" height="60" as="geometry" /></mxCell><mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Seta tracejada com seta aberta: dependência de uso (a origem usa o destino). Infraestrutura depende de aplicacao, aplicacao depende de dominio, e dominio não depende de nenhuma camada.&lt;br&gt;Seta tracejada com triângulo vazio: realização de interface (o adapter realiza a porta).&lt;br&gt;Seta contínua: chamada entre objetos.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="340" height="150" as="geometry" /></mxCell><mxCell id="e-chama" value="chama" style="html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" source="m-outro" target="caso" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-executar" value="executar(comando)" style="html=1;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ctrl" target="caso" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-dep-web-app" style="html=1;dashed=1;endArrow=open;endSize=10;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="440" as="sourcePoint" /><mxPoint x="400" y="440" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e-dep-app-dom" style="html=1;dashed=1;endArrow=open;endSize=10;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="440" as="sourcePoint" /><mxPoint x="920" y="440" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e-real-rep" style="html=1;dashed=1;endArrow=block;endFill=0;strokeWidth=1.5;" edge="1" source="adPers" target="portaRep" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-real-ext" style="html=1;dashed=1;endArrow=block;endFill=0;strokeWidth=1.5;" edge="1" source="adExt" target="portaExt" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-real-regra" style="html=1;dashed=1;endArrow=block;endFill=0;strokeWidth=1.5;" edge="1" source="regraPura" target="regra" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-uso-map" style="html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" source="adPers" target="map" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-uso-ent" style="html=1;endArrow=open;endSize=8;fontSize=10;" edge="1" source="map" target="ent" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="casos-de-uso" name="casos-de-uso">
