da-cor-catalogo" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2063.84" y="998" width="14" height="14" as="geometry"/></mxCell><mxCell id="legenda-mod-catalogo" value="catalogo" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2081.84" y="996" width="55.08" height="18" as="geometry"/></mxCell><mxCell id="legenda-cor-estoque" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2154.92" y="998" width="14" height="14" as="geometry"/></mxCell><mxCell id="legenda-mod-estoque" value="estoque" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2172.92" y="996" width="51.12" height="18" as="geometry"/></mxCell><mxCell id="legenda-cor-vendas" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2242.04" y="998" width="14" height="14" as="geometry"/></mxCell><mxCell id="legenda-mod-vendas" value="vendas" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2260.04" y="996" width="44.96" height="18" as="geometry"/></mxCell><mxCell id="legenda-cor-notificacoes" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2323" y="998" width="14" height="14" as="geometry"/></mxCell><mxCell id="legenda-mod-notificacoes" value="notificacoes" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2341" y="996" width="77.52" height="18" as="geometry"/></mxCell><mxCell id="legenda-cor-recomendacao" value="" style="rounded=0;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1"><mxGeometry x="2436.52" y="998" width="14" height="14" as="geometry"/></mxCell><mxCell id="legenda-mod-recomendacao" value="recomendacao" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2454.52" y="996" width="83.24" height="18" as="geometry"/></mxCell><mxCell id="legenda-cor-compartilhado" value="" style="rounded=0;html=1;fillColor=#eeeeee;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="2555.76" y="998" width="14" height="14" as="geometry"/></mxCell><mxCell id="legenda-mod-compartilhado" value="compartilhado" style="text;html=1;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2573.76" y="996" width="85" height="18" as="geometry"/></mxCell><mxCell id="legenda-texto" value="• PK = chave primária; FK = chave estrangeira com restrição no banco, entre tabelas do mesmo módulo; UK = único; ? no tipo = aceita NULL.&lt;br&gt;• REF → tabela: referência a outro módulo, coluna sem restrição de FK e sem linha no diagrama (módulos não acessam a persistência um do outro, docs/arquitetura.md).&lt;br&gt;• Toda PK `id` é bigint gerado por sequence &amp;lt;tabela&amp;gt;_seq com início 10000; 1 a 9999 ficam para o seed (DEC-14).&lt;br&gt;• E-mail, telefone e CPF não têm UK: a unicidade vale só entre contas em uso e é checada pela aplicação (DEC-10).&lt;br&gt;• Colunas json são snapshots imutáveis: o objeto como era no momento da compra, com o id de origem.&lt;br&gt;• Toda tabela de escrita tem uma &amp;lt;tabela&amp;gt;_aud do Envers (colunas da tabela + rev → revisao.id + revtype) (DEC-14), exceto chamada_ia, log só de inserção (DEC-03).&lt;br&gt;• Pontas (pé de galinha): traço = um; círculo = zero (opcional); três pernas = muitos. A linha sai da coluna FK e chega à PK da tabela referenciada." style="text;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1894" y="1024" width="1272" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
